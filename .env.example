# Local development proxy only. Cloud AI secrets belong in Supabase Edge Functions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public project connection. Never substitute a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SLASHTASKS_AI_ENABLED=false
# Use otp only after configuring custom SMTP and code email templates.
SLASHTASKS_AUTH_MODE=magic_link
# Opt in to viewing this Mac's app from other devices on your private network.
SLASHTASKS_LAN_ENABLED=false
